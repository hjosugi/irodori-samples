{
  "_comment": [
    "OpenSearch feature sample for Irodori Table.",
    "Run against `task start -- openSearch`.",
    "Needs the `irodori.opensearch` connector extension.",
    "The request shapes match the Elasticsearch sample; that is the point."
  ],

  "count all orders": {
    "path": "/orders/_count"
  },

  "top delivered orders": {
    "path": "/orders/_search",
    "body": {
      "size": 5,
      "query": { "term": { "status": "delivered" } },
      "sort": [ { "total": "desc" } ]
    }
  },

  "revenue by status": {
    "path": "/orders/_search",
    "body": {
      "size": 0,
      "aggs": {
        "by_status": {
          "terms": { "field": "status" },
          "aggs": { "revenue": { "sum": { "field": "total" } } }
        }
      }
    }
  },

  "mapping, to see how the seed typed each field": {
    "path": "/orders/_mapping"
  }
}
